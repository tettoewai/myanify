// This is your Prisma schema file for Myanify Music Streaming Platform
// Supports both Admin and Listener applications

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User model - supports both Admin and Listener roles
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // For authentication
  avatarUrl    String?
  role         UserRole @default(LISTENER)

  // Email verification
  emailVerified           DateTime?
  verificationToken       String?
  verificationTokenExpiry DateTime?

  // Password reset
  resetToken       String?   @db.Text
  resetTokenExpiry DateTime?

  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  playlists        Playlist[]
  likedSongs       LikedSong[]
  likedArtists     LikedArtist[]
  playHistory      PlayHistory[]
  subscriptions    PremiumSubscription[]
  uploads          Upload[]
  accounts         Account[]
  sessions         Session[]
  paymentRequests  PaymentRequest[]
  offlineDownloads OfflineDownload[]
  deviceLicenses   DeviceLicense[]
  paymentMethods   PaymentMethod[]
  songRequests     SongRequest[] @relation("SongRequestUser")
  reviewedRequests SongRequest[] @relation("SongRequestReviewer")

  @@index([email])
  @@index([role])
}

enum UserRole {
  ADMIN
  LISTENER
}

// Reusable SEO metadata for public-facing pages
model SeoMetadata {
  id                 String   @id @default(cuid())
  title              String?
  description        String?  @db.Text
  keywords           String[]
  canonicalUrl       String?
  ogTitle            String?
  ogDescription      String?  @db.Text
  ogImageUrl         String?
  twitterTitle       String?
  twitterDescription String?  @db.Text
  twitterImageUrl    String?
  schemaMarkup       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  artist   Artist?
  album    Album?
  genre    Genre?
  song     Song?
  playlist Playlist?
}

// Artist model
model Artist {
  id               String   @id @default(cuid())
  name             String
  englishName      String?
  slug             String   @unique
  aliases          String[]
  imageUrl         String?
  bio              String?  @db.Text
  englishBio       String?  @db.Text
  country          String?
  monthlyListeners Int      @default(0)
  seoId            String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  seo          SeoMetadata?  @relation(fields: [seoId], references: [id])
  songs        SongArtist[]
  artistGenres ArtistGenre[]
  likedBy      LikedArtist[]

  @@index([name])
  @@index([englishName])
  @@index([slug])
}

// Genre model
model Genre {
  id                 String   @id @default(cuid())
  name               String   @unique
  englishName        String?
  slug               String   @unique
  description        String?  @db.Text
  englishDescription String?  @db.Text
  imageUrl           String?
  seoId              String?  @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  seo          SeoMetadata?  @relation(fields: [seoId], references: [id])
  songs        Song[]
  artistGenres ArtistGenre[]

  @@index([name])
  @@index([slug])
}

// Many-to-many relationship between Artist and Genre
model ArtistGenre {
  id        String   @id @default(cuid())
  artistId  String
  genreId   String
  createdAt DateTime @default(now())

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([artistId, genreId])
  @@index([artistId])
  @@index([genreId])
}

enum AlbumType {
  SINGLE
  EP
  ALBUM
}

// Album model
model Album {
  id                 String    @id @default(cuid())
  name               String
  englishName        String?
  slug               String    @unique
  coverUrl           String?
  type               AlbumType @default(ALBUM)
  description        String?   @db.Text
  englishDescription String?   @db.Text
  releaseDate        DateTime?
  seoId              String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  seo   SeoMetadata? @relation(fields: [seoId], references: [id])
  songs Song[]

  @@index([name])
  @@index([englishName])
  @@index([slug])
}

// Many-to-many relationship between Song and Artist
model SongArtist {
  id        String   @id @default(cuid())
  songId    String
  artistId  String
  createdAt DateTime @default(now())

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([songId, artistId])
  @@index([songId])
  @@index([artistId])
}

// Song model - main music track
model Song {
  id                 String    @id @default(cuid())
  title              String
  englishTitle       String?
  slug               String    @unique
  alternativeTitles  String[]
  description        String?   @db.Text
  englishDescription String?   @db.Text
  duration           Int // Duration in seconds (stored as seconds for precision, but minutes is the standard unit in UI)
  audioUrl           String // URL to audio file
  coverUrl           String? // Album cover image URL
  language           String?   @default("my")
  releaseDate        DateTime?
  isPremium          Boolean   @default(false)
  isPublished        Boolean   @default(false) // Admin can publish/unpublish
  playCount          Int       @default(0)
  seoId              String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Foreign keys
  albumId String?
  genreId String?

  // Relations
  seo              SeoMetadata?      @relation(fields: [seoId], references: [id])
  artists          SongArtist[]
  album            Album?            @relation(fields: [albumId], references: [id], onDelete: SetNull)
  genre            Genre?            @relation(fields: [genreId], references: [id], onDelete: SetNull)
  lyrics           Lyrics[]
  likedBy          LikedSong[]
  playHistory      PlayHistory[]
  playlistSongs    PlaylistSong[]
  offlineDownloads OfflineDownload[]

  @@index([title])
  @@index([englishTitle])
  @@index([slug])
  @@index([albumId])
  @@index([genreId])
  @@index([isPublished])
  @@index([isPremium])
  @@index([releaseDate])
  @@index([createdAt])
}

model Lyrics {
  id        String   @id @default(cuid())
  songId    String
  language  String   @default("my")
  lines     Json     @db.JsonB
  createdAt DateTime @default(now())

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, language])
  @@index([songId])
  @@index([language])
}

// Playlist model
model Playlist {
  id          String   @id @default(cuid())
  name        String
  englishName String?
  slug        String   @unique
  description String?  @db.Text
  coverUrl    String?
  isPublic    Boolean  @default(true)
  seoId       String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Foreign keys
  createdById String

  // Relations
  seo       SeoMetadata?   @relation(fields: [seoId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  songs     PlaylistSong[]

  @@index([slug])
  @@index([createdById])
  @@index([isPublic])
  @@index([createdAt])
}

// Many-to-many relationship between Playlist and Song
model PlaylistSong {
  id         String   @id @default(cuid())
  playlistId String
  songId     String
  order      Int // Order of song in playlist
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
  @@index([playlistId])
  @@index([songId])
}

// LikedSong model - tracks which users like which songs
model LikedSong {
  id      String   @id @default(cuid())
  userId  String
  songId  String
  likedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
}

// LikedArtist model - tracks which users like which artists
model LikedArtist {
  id       String   @id @default(cuid())
  userId   String
  artistId String
  likedAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
  @@index([userId])
  @@index([artistId])
}

// PlayHistory model - tracks user listening history
model PlayHistory {
  id       String   @id @default(cuid())
  userId   String
  songId   String
  playedAt DateTime @default(now())
  duration Int? // How long the song was played (in seconds)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([songId])
  @@index([playedAt])
  @@index([userId, playedAt])
}

// Plan model - for dynamic subscription plans
model Plan {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Float
  duration    Int // Duration in days
  type        PlanType @default(MONTHLY)
  features    Json? // Array of feature strings
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  subscriptions   PremiumSubscription[]
  paymentRequests PaymentRequest[]

  @@index([isActive])
}

// PremiumSubscription model
model PremiumSubscription {
  id                String             @id @default(cuid())
  userId            String             @unique
  status            SubscriptionStatus @default(ACTIVE)
  planType          PlanType           @default(MONTHLY)
  startDate         DateTime           @default(now())
  endDate           DateTime?
  cancelAtPeriodEnd Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@index([planId])
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum PlanType {
  MONTHLY
  YEARLY
  LIFETIME
}

// Ad model - for sponsored content
model Ad {
  id              String    @id @default(cuid())
  title           String
  description     String?   @db.Text
  imageUrl        String?
  linkUrl         String
  sponsor         String
  isActive        Boolean   @default(true)
  startDate       DateTime  @default(now())
  endDate         DateTime?
  clickCount      Int       @default(0)
  impressionCount Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([startDate, endDate])
}

// Upload model - tracks file uploads by admin
model Upload {
  id           String   @id @default(cuid())
  fileName     String
  fileType     String // 'audio', 'image', 'lyrics'
  fileUrl      String
  fileSize     Int // Size in bytes
  mimeType     String?
  uploadedById String
  uploadedAt   DateTime @default(now())

  // Relations
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([uploadedById])
  @@index([fileType])
  @@index([uploadedAt])
}

// Auth.js models for authentication
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// PaymentRequest model - for manual payment verification
model PaymentRequest {
  id              String        @id @default(cuid())
  userId          String
  paymentMethodId String?
  planType        PlanType // MONTHLY or YEARLY
  amount          Float
  referenceNumber String        @unique // Unique payment reference for m-banking
  status          PaymentStatus @default(PENDING)
  transactionId   String? // User-provided transaction ID
  proofImageUrl   String? // Optional screenshot of payment
  notes           String?       @db.Text // Admin notes
  verifiedBy      String? // Admin user ID who verified
  verifiedAt      DateTime?
  rejectedReason  String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([referenceNumber])
  @@index([createdAt])
  @@index([paymentMethodId])
  @@index([planId])
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

// OfflineDownload model - tracks downloaded songs for VIP users
model OfflineDownload {
  id                String         @id @default(cuid())
  userId            String
  songId            String
  encryptedFilePath String? // Server-side encrypted file path (if stored on server)
  downloadStatus    DownloadStatus @default(PENDING)
  progress          Int            @default(0) // 0-100
  downloadedAt      DateTime       @default(now())
  expiresAt         DateTime? // When the download expires (if subscription ends)
  fileSize          Int? // Size in bytes
  checksum          String? // File checksum for integrity verification
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([userId, songId])
  @@index([userId])
  @@index([songId])
  @@index([downloadStatus])
  @@index([expiresAt])
}

enum DownloadStatus {
  PENDING
  DOWNLOADING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

// DeviceLicense model - tracks device registrations for DRM
model DeviceLicense {
  id              String     @id @default(cuid())
  userId          String
  deviceId        String // Unique device identifier (generated client-side)
  deviceName      String? // User-friendly device name
  deviceType      DeviceType // MOBILE or WEB
  licenseKey      String     @unique // Encrypted license key
  isValid         Boolean    @default(true)
  lastValidatedAt DateTime   @default(now())
  expiresAt       DateTime? // License expiration (if any)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([deviceId])
  @@index([licenseKey])
  @@index([isValid])
}

enum DeviceType {
  MOBILE
  WEB
}

// PaymentMethod model - payment methods for VIP subscriptions (managed by admin)
model PaymentMethod {
  id            String            @id @default(cuid())
  name          String // e.g., "KBZ Bank", "AYA Bank", "Wave Money"
  type          PaymentMethodType // BANK, MOBILE_MONEY, etc.
  accountName   String? // Account holder name
  accountNumber String? // Bank account number or phone number
  qrCodeUrl     String? // QR code image URL
  instructions  String?           @db.Text // Payment instructions for users
  isActive      Boolean           @default(true)
  displayOrder  Int               @default(0) // Order for display
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  createdById   String // Admin who created this

  createdBy       User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  paymentRequests PaymentRequest[]

  @@index([isActive])
  @@index([displayOrder])
  @@index([createdById])
}

enum PaymentMethodType {
  BANK
  MOBILE_MONEY
  E_WALLET
  OTHER
}

// SongRequest model - for user song requests
model SongRequest {
  id         String            @id @default(cuid())
  userId     String
  songTitle  String
  artistName String
  notes      String?           @db.Text
  status     SongRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  user     User  @relation("SongRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("SongRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum SongRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Side-loaded Android releases (no Play Store). One row per versionCode;
// the highest active versionCode is served by GET /api/mobile-update.
// Seeded from mobile-release.json; updated via POST /api/mobile-update
// with RELEASE_ADMIN_TOKEN (no web redeploy needed).
model MobileRelease {
  id                 String   @id @default(cuid())
  version            String
  versionCode        Int      @unique
  apkUrl             String
  notes              String   @default("")
  mandatory          Boolean  @default(false)
  sha256             String?
  md5                String?
  fileSize           Int?
  minVersionCode     Int?
  rollout            Int?
  certSha256         String?
  previousVersion    String?
  previousVersionCode Int?
  previousApkUrl     String?
  signature          String?  @db.Text
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([isActive, versionCode])
}

// Lightweight update telemetry (no PII). Powers adoption dashboards.
model MobileUpdateEvent {
  id                 String   @id @default(cuid())
  event              String
  platform           String   @default("android")
  currentVersionCode Int?
  latestVersionCode  Int?
  error              String?  @db.Text
  createdAt          DateTime @default(now())

  @@index([event, createdAt])
  @@index([latestVersionCode])
}

// Admin-configurable app settings (key-value). Used for download limits,
// VIP gating, and other runtime tunables without redeploy.
model AppSetting {
  key         String   @id
  value       String   @db.Text
  updatedAt   DateTime @updatedAt
  updatedById String?
}
