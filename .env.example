NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

## Device license signing (mobile offline downloads). Falls back to AUTH_SECRET if unset.
ENCRYPTION_MASTER_KEY=

## Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DATABASE_URL=
# Keep this small for serverless/Neon deployments; increase only if needed.
DATABASE_POOL_MAX=5

## Upstash Redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

## Typesense Search
TYPESENSE_HOST=
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL=https
TYPESENSE_ADMIN_API_KEY=
TYPESENSE_SEARCH_API_KEY=

## Email
RESEND_API_KEY=
EMAIL_FROM="Myanify <noreply@example.com>"
SEND_EMAILS=true
# Secret protecting /api/cron/* maintenance jobs (bearer token)
CRON_SECRET=
# Age (days) after which unverified user accounts are deleted
USER_CLEANUP_DAYS=3

## Push notifications (Expo Push API). Get from expo.dev → Account → Access Tokens.
EXPO_ACCESS_TOKEN=

## Android self-update (GitHub Releases, no Play Store)
RELEASE_REPO=tettoewai/myanify-releases
# Push manifest to production without redeploy (POST /api/mobile-update)
RELEASE_ADMIN_TOKEN=
RELEASE_API_BASE=https://myanify.vercel.app
# Ed25519 manifest signing (pnpm gen:release-keys). Private stays on server.
RELEASE_SIGNING_PRIVATE_KEY=
RELEASE_SIGNING_PUBLIC_KEY=
# Signing-cert SHA-256 fingerprint recorded at build time (informational)
RELEASE_CERT_SHA256=